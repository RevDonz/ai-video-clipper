WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_LANGUAGE=id
# Opsional, kosong = default bawaan (docs/operations/TRANSCRIPTION.md). Nilai di bawah
# adalah default-nya; WHISPER_INITIAL_PROMPT berisi teks prompt sendiri, atau off.
# WHISPER_CONDITION_ON_PREVIOUS_TEXT=false
# WHISPER_PROMPT_EVERY_WINDOW=true
# WHISPER_INITIAL_PROMPT=
MAX_UPLOAD_BYTES=524288000
# Opsional: batas ukuran ZIP "Unduh semua" di halaman proyek, dalam byte. Kosong = 2 GiB.
# MAX_ZIP_BYTES=2147483648
APP_USERNAME=admin
APP_PASSWORD=change-this-before-starting
APP_SESSION_SECRET=generate-a-random-secret-with-at-least-32-characters
# Bahasa UI aktif, dipisah koma. id selalu aktif.
POTONGIN_LOCALES=id

# --- Kapasitas penyimpanan job (wajib: compose berhenti kalau salah satunya kosong) ---
# Nilainya baseline terukur di docs/operations/STORAGE_RETENTION.md (disk 128 GB, 41 GB kosong);
# ukur ulang untuk disk Anda. Job lama tidak pernah dihapus otomatis: kalau batas tercapai, job
# baru ditolak.
# Batas total semua job di JOBS_ROOT, dihitung dari blok disk yang terpakai (byte).
JOBS_STORAGE_QUOTA_BYTES=32212254720
# Sisa ruang disk minimal (byte); di bawahnya job baru ditolak.
JOBS_STORAGE_MIN_FREE_BYTES=16106127360
# Cadangan per job aktif (byte): unduhan atau unggahan, kerja, analisis, dan hasil render.
JOBS_STORAGE_ACTIVE_RESERVE_BYTES=2147483648
# Batas pemindaian folder job: jumlah entri, kedalaman, dan waktu (ms). Lewat batas = job ditolak.
JOBS_STORAGE_SCAN_MAX_ENTRIES=200000
JOBS_STORAGE_SCAN_MAX_DEPTH=16
JOBS_STORAGE_SCAN_DEADLINE_MS=30000
# Selama unggahan berjalan, ruangnya dicek ulang tiap N byte (8-16 MiB) dan tiap N ms.
JOBS_STORAGE_RECHECK_BYTES=8388608
JOBS_STORAGE_RECHECK_INTERVAL_MS=5000

# --- Editor klip (bawaan rilis di compose.yaml; baris di bawah adalah nilai bawaannya) ---
# Untuk mematikan satu fitur, tulis baris tanpa tanda # dengan nilai matinya, lalu jalankan
# "docker compose up -d" lagi (tidak perlu build ulang). Panduan: docs/editor/OPERASIONAL.md §2.
# Mesin render klip otomatis: edit-v2 (bawaan, kompiler yang sama dengan ekspor editor) atau
# legacy (mesin lama, hanya untuk rollback; docs/editor/OPERASIONAL.md §2).
# Rollback: POTONGIN_RENDER_ENGINE=legacy
# POTONGIN_RENDER_ENGINE=edit-v2
# Jeda hening di klip otomatis dipendekkan jadi 0,2 detik (tetap bisa dikembalikan di editor).
# Mematikan: POTONGIN_AUTO_PAUSE_TRIM=off
# POTONGIN_AUTO_PAUSE_TRIM=on
# Tombol "Edit klip" dan semua rute editor. Mematikan: POTONGIN_EDITOR_V3=off
# POTONGIN_EDITOR_V3=on
# Unggah logo dan musik di editor (gerbang keamanan QG-SEC lolos). Mematikan: POTONGIN_EDITOR_UPLOADS=off
# POTONGIN_EDITOR_UPLOADS=on
# Saran hook dari AI gratis di Pengaturan (saran instan tetap ada walau dimatikan).
# Mematikan: POTONGIN_EDITOR_LLM=off
# POTONGIN_EDITOR_LLM=on

# --- LLM untuk pemilihan hook (Selection V3) ---
# CARA YANG DISARANKAN: atur penyedia, API key, URL, dan model di halaman
# Pengaturan (/settings) di dashboard. Tidak perlu mengedit .env lagi; key
# disimpan terenkripsi (AES-256-GCM) di /data/settings. Kalau .env sudah berisi
# konfigurasi LLM, klik "Impor dari konfigurasi server (.env)" di halaman itu
# sekali saja. Setelah pengaturan tersimpan, variabel POTONGIN_LLM_* dan *_API_KEY
# di bawah TIDAK dipakai lagi (hanya cadangan selama belum ada pengaturan).
#
# Key dikunci dengan POTONGIN_SETTINGS_SECRET kalau diisi, kalau tidak dengan
# APP_SESSION_SECRET. Kalau secret ini diganti, key tersimpan tidak bisa dibuka
# lagi (halaman Pengaturan akan meminta isi ulang). Isi POTONGIN_SETTINGS_SECRET
# (acak, minimal 32 karakter) kalau Anda ingin bisa merotasi APP_SESSION_SECRET
# tanpa mengisi ulang semua key.
# POTONGIN_SETTINGS_SECRET=
#
# Panduan lengkap: docs/operations/LLM_PROVIDERS.md
# Penyedia dicoba berurutan; yang key-nya kosong dilewati. Tanpa key sama sekali,
# Selection V3 tetap jalan dengan pemilih heuristik lokal (tanpa internet).
POTONGIN_LLM_PROVIDERS=ollama-cloud,openrouter,gemini,groq
POTONGIN_LLM_FREE_ONLY=1
# Isi key penyedia yang Anda punya (placeholder, jangan commit key asli):
OLLAMA_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
# Alternatif lain (Cerebras/Mistral gratis; DeepSeek/OpenAI berbayar, dilewati saat FREE_ONLY=1):
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
# Opsional. Kosong = pakai default preset.
# POTONGIN_LLM_PROVIDER=gemini                # satu penyedia saja (menang atas ..._PROVIDERS)
# POTONGIN_LLM_MODEL=                         # model penyedia pertama
# POTONGIN_LLM_FALLBACK_MODELS=               # daftar cadangan penyedia pertama; none = tanpa cadangan
# POTONGIN_LLM_BASE_URL=                      # wajib untuk custom; http:// hanya untuk server lokal
# POTONGIN_LLM_TIMEOUT=
# POTONGIN_LLM_RPM=
# POTONGIN_LLM_CONTEXT_TOKENS=
# POTONGIN_LLM_MAX_OUTPUT_TOKENS=
# POTONGIN_LLM_REASONING_EFFORT=low
# POTONGIN_LLM_GEMINI_MODEL=gemini-3.8-flash  # contoh override per penyedia
#
# Server OpenAI-compatible milik sendiri: sampai 3 (custom, custom2, custom3), masing-masing
# dengan variabelnya sendiri. Dianggap milik Anda, jadi FREE_ONLY tidak menyaringnya.
# http:// hanya untuk localhost / host.docker.internal (compose sudah memetakan host.docker.internal).
# POTONGIN_LLM_PROVIDERS=custom,custom2,ollama-cloud,openrouter
# POTONGIN_LLM_CUSTOM_NAME=Hermes                          # nama tampilan di dashboard
# POTONGIN_LLM_CUSTOM_BASE_URL=https://hermes.example/v1
# POTONGIN_LLM_CUSTOM_MODEL=
# POTONGIN_LLM_CUSTOM_API_KEY=
# POTONGIN_LLM_CUSTOM2_NAME=9Router                        # gateway 9Router, API di port 20128
# POTONGIN_LLM_CUSTOM2_BASE_URL=http://host.docker.internal:20128/v1
# POTONGIN_LLM_CUSTOM2_MODEL=                              # nama combo/model dari dashboard 9Router
# POTONGIN_LLM_CUSTOM2_API_KEY=                            # key dari dashboard 9Router (REQUIRE_API_KEY=true)
# Jangan arahkan job otomatis ke langganan Claude/ChatGPT/Copilot lewat 9Router: bisa melanggar
# ketentuan penyedianya. Lihat docs/operations/LLM_PROVIDERS.md.
# Matikan LLM sementara tanpa menghapus key:
# POTONGIN_LLM=off
# Batas waktu tiap unduhan subtitle YouTube (ms, 5000–600000; default 120000):
# POTONGIN_CAPTIONS_TIMEOUT_MS=120000
# Unduhan video YouTube dihentikan sebagai "Unduhan macet" kalau progresnya tidak bergerak
# selama ini (ms, 100–3600000; default 120000). Tahap merge tidak dihitung.
# Lihat docs/operations/UNDUHAN_YOUTUBE.md.
# POTONGIN_DOWNLOAD_STALL_MS=120000
