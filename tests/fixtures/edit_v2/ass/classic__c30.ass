Dialogue: 0,0:00:00.26,0:00:01.79,Caption,,0,0,0,,kopi katanya sumpah lagi
Dialogue: 0,0:00:01.83,0:00:02.76,Caption,,0,0,0,,dong dong mah.
Dialogue: 0,0:00:03.43,0:00:04.53,Caption,,0,0,0,,nahan langsung ketawa
Dialogue: 0,0:00:06.13,0:00:07.90,Caption,,0,0,0,,anu anu sumpah sumpah
Dialogue: 0,0:00:07.97,0:00:08.67,Caption,,0,0,0,,katanya film.
Dialogue: 0,0:00:09.14,0:00:10.64,Caption,,0,0,0,,orang kenapa pelan pokoknya
Dialogue: 0,0:00:10.77,0:00:12.27,Caption,,0,0,0,,kru waktu eh sih
Dialogue: 0,0:00:12.34,0:00:12.64,Caption,,0,0,0,,orang.
Dialogue: 0,0:00:13.07,0:00:14.47,Caption,,0,0,0,,anu mau waktu eh
Dialogue: 0,0:00:14.61,0:00:14.91,Caption,,0,0,0,,dong?
Dialogue: 0,0:00:16.28,0:00:17.71,Caption,,0,0,0,,dong eh pulang syuting
Dialogue: 0,0:00:17.78,0:00:18.91,Caption,,0,0,0,,anu nggak sendiri.
Dialogue: 0,0:00:19.91,0:00:21.48,Caption,,0,0,0,,jadi sendiri nggak nahan
Dialogue: 0,0:00:21.58,0:00:22.95,Caption,,0,0,0,,wkwk mah sih masuk.
Dialogue: 0,0:00:23.72,0:00:25.25,Caption,,0,0,0,,juga dong anu gue.
Dialogue: 0,0:00:25.75,0:00:27.22,Caption,,0,0,0,,semua waktu kita orang
Dialogue: 0,0:00:27.25,0:00:27.59,Caption,,0,0,0,,ketawa?
Dialogue: 0,0:00:27.99,0:00:29.76,Caption,,0,0,0,,padahal hati mah mau.
Dialogue: 0,0:00:29.99,0:00:31.69,Caption,,0,0,0,,hati masuk sih sendiri.
Dialogue: 0,0:00:33.09,0:00:34.73,Caption,,0,0,0,,pulang juga ternyata pas
Dialogue: 0,0:00:34.76,0:00:36.43,Caption,,0,0,0,,hati pelan katanya pas
Dialogue: 0,0:00:36.50,0:00:36.90,Caption,,0,0,0,,security.
Dialogue: 0,0:00:37.20,0:00:38.66,Caption,,0,0,0,,sih nggak kopi katanya
Dialogue: 0,0:00:38.77,0:00:40.33,Caption,,0,0,0,,sumpah lagi dong dong
Dialogue: 0,0:00:40.40,0:00:40.70,Caption,,0,0,0,,mah.
Dialogue: 0,0:00:41.23,0:00:42.94,Caption,,0,0,0,,nahan langsung ketawa kok
Dialogue: 0,0:00:43.04,0:00:43.37,Caption,,0,0,0,,ternyata.
Dialogue: 0,0:00:43.70,0:00:45.20,Caption,,0,0,0,,semua katanya masuk aja
Dialogue: 0,0:00:45.27,0:00:46.27,Caption,,0,0,0,,masuk eh sumpah.
Dialogue: 0,0:00:46.61,0:00:48.01,Caption,,0,0,0,,dong semua sih sendiri
Dialogue: 0,0:00:48.14,0:00:48.51,Caption,,0,0,0,,waktu.
Dialogue: 0,0:00:49.74,0:00:51.24,Caption,,0,0,0,,langsung sih security terus
Dialogue: 0,0:00:51.28,0:00:52.68,Caption,,0,0,0,,itu semua orang.
Dialogue: 0,0:00:52.98,0:00:54.35,Caption,,0,0,0,,langsung kenapa padahal aja
Dialogue: 0,0:00:54.41,0:00:55.62,Caption,,0,0,0,,syuting dia ambil.
Dialogue: 0,0:00:56.28,0:00:57.95,Caption,,0,0,0,,katanya jadi abis security
Dialogue: 0,0:00:58.05,0:00:58.35,Caption,,0,0,0,,katanya.
Dialogue: 0,0:00:58.68,0:01:00.22,Caption,,0,0,0,,itu ternyata film dong
Dialogue: 0,0:01:00.39,0:01:00.75,Caption,,0,0,0,,dong?
Dialogue: 0,0:01:01.25,0:01:02.96,Caption,,0,0,0,,dia nggak kru pelan.
Dialogue: 0,0:01:04.32,0:01:05.69,Caption,,0,0,0,,pokoknya semua ternyata dong
Dialogue: 0,0:01:05.76,0:01:07.06,Caption,,0,0,0,,waktu ternyata nggak film.
Dialogue: 0,0:01:07.43,0:01:08.90,Caption,,0,0,0,,abis bukan kok eh
Dialogue: 0,0:01:09.03,0:01:10.23,Caption,,0,0,0,,masuk hati sih.
Dialogue: 0,0:01:11.66,0:01:12.03,Caption,,0,0,0,,aja
