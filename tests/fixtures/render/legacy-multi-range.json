{
 "center_crop_audio": [
  "ffmpeg",
  "-y",
  "-ss",
  "10.000",
  "-t",
  "2.002",
  "-i",
  "/src/source.mp4",
  "-ss",
  "4.000",
  "-t",
  "5.000",
  "-i",
  "/src/source.mp4",
  "-filter_complex",
  "[0:0]setpts=PTS-STARTPTS[source0];[source0]scale=360:640:force_original_aspect_ratio=increase,crop=360:640,setsar=1[video0];[0:1]asetpts=PTS-STARTPTS,apad,atrim=duration=2.002,afade=t=out:st=1.972:d=0.030[audio0];[1:0]setpts=PTS-STARTPTS[source1];[source1]scale=360:640:force_original_aspect_ratio=increase,crop=360:640,setsar=1[video1];[1:1]asetpts=PTS-STARTPTS,apad,atrim=duration=5.000,afade=t=in:st=0:d=0.030[audio1];[video0][audio0][video1][audio1]concat=n=2:v=1:a=1[joined][audio];[joined]ass=filename='captions.ass'[video]",
  "-map",
  "[video]",
  "-map",
  "[audio]",
  "-map_metadata",
  "-1",
  "-c:v",
  "libx264",
  "-preset",
  "veryfast",
  "-crf",
  "21",
  "-pix_fmt",
  "yuv420p",
  "-c:a",
  "aac",
  "-b:a",
  "128k",
  "-movflags",
  "+faststart",
  "-f",
  "mp4",
  "/proc/self/fd/9"
 ],
