  "-t",
  "2.000",
  "-i",
  "/src/source.mp4",
  "-filter_complex",
  "[0:0]setpts=PTS-STARTPTS[source0];[source0]split=2[background0][foreground0];[background0]scale=360:640:force_original_aspect_ratio=increase,crop=360:640,gblur=sigma=35[blurred0];[foreground0]scale=360:640:force_original_aspect_ratio=decrease[fit0];[blurred0][fit0]overlay=(W-w)/2:(H-h)/2,setsar=1[video0];anullsrc=channel_layout=stereo:sample_rate=48000,atrim=duration=1.000,afade=t=out:st=0.970:d=0.030[audio0];[1:0]setpts=PTS-STARTPTS[source1];[source1]split=2[background1][foreground1];[background1]scale=360:640:force_original_aspect_ratio=increase,crop=360:640,gblur=sigma=35[blurred1];[foreground1]scale=360:640:force_original_aspect_ratio=decrease[fit1];[blurred1][fit1]overlay=(W-w)/2:(H-h)/2,setsar=1[video1];anullsrc=channel_layout=stereo:sample_rate=48000,atrim=duration=2.000,afade=t=in:st=0:d=0.030[audio1];[video0][audio0][video1][audio1]concat=n=2:v=1:a=1[joined][audio];[joined]ass=filename='captions.ass'[video]",
  "-map",
  "[video]",
