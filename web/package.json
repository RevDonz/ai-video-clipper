{
  "name": "ai-video-clipper-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:list": "E2E_ALLOW_SKIP=1 playwright test --list",
    "test:e2e:safe-skip": "E2E_ALLOW_SKIP=1 E2E_NO_WEB_SERVER=1 playwright test",
    "test:e2e:read-only": "playwright test e2e/read-only.spec.mjs e2e/smoke.spec.mjs"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  }
}
