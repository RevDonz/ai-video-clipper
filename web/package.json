{
  "name": "ai-video-clipper-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:list": "E2E_ALLOW_SKIP=1 playwright test --list",
    "test:e2e:safe-skip": "E2E_ALLOW_SKIP=1 E2E_NO_WEB_SERVER=1 playwright test",
    "test:e2e:read-only": "playwright test e2e/read-only.spec.mjs e2e/smoke.spec.mjs",
    "test:parity": "playwright test e2e/parity-text.spec.mjs --project=desktop-chromium",
    "test:player": "playwright test e2e/editor-player.spec.mjs --project=desktop-chromium",
    "test:editor-flow": "playwright test e2e/editor-flow.spec.mjs --project=desktop-chromium"
  },
  "dependencies": {
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@internationalized/date": "3.12.4",
    "busboy": "^1.6.0",
    "jassub": "2.5.16",
    "mediabunny": "1.59.1",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-aria": "3.52.1",
    "react-aria-components": "1.21.1",
    "react-dom": "19.3.0",
    "tw-animate-css": "1.4.0",
    "use-intl": "4.14.9"
  },
  "devDependencies": {
    "@babel/parser": "7.29.9",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3"
  }
}
